# Supabase Configuration (Template)
# Replace these with your actual keys from the Supabase dashboard
# Note: For React Native (Expo), environment variables must be prefixed with EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=-----------------------------
EXPO_PUBLIC_SUPABASE_ANON_KEY=--------------------------

# ML Backend API URL
# For physical device testing, use your computer's local IP (e.g., http://192.168.x.x:8000)
# For emulator, use http://10.0.2.2:8000 (Android) or http://localhost:8000 (iOS Simulator)
EXPO_PUBLIC_ML_API_URL=----------------------------
